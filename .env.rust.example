# ROMA Rust Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# LLM Provider API Keys (Required)
# ========================================
# You need at least ONE of these:

# Anthropic (Claude) - Recommended
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI (GPT)
# OPENAI_API_KEY=sk-your-key-here

# ========================================
# Runtime Configuration
# ========================================

# Environment mode
ROMA_ENV=development

# Maximum recursion depth (default: 5)
ROMA_MAX_DEPTH=6

# Enable verbose logging
ROMA_VERBOSE=true

# Enable logging to file
ROMA_ENABLE_LOGGING=true

# Log level: DEBUG, INFO, WARN, ERROR
ROMA_LOG_LEVEL=INFO

# ========================================
# Storage Configuration
# ========================================

# Base path for execution storage
STORAGE_BASE_PATH=/tmp/roma

# ========================================
# Cache Configuration
# ========================================

# Enable caching
ROMA_CACHE_ENABLED=true
ROMA_CACHE_DISK=true
ROMA_CACHE_MEMORY=true

# Cache directory
DSPY_CACHE_DIR=.cache/dspy

# ========================================
# Resilience Configuration
# ========================================

# Retry strategy: exponential_backoff, linear, constant
ROMA_RETRY_STRATEGY=exponential_backoff

# Maximum retry attempts
ROMA_MAX_RETRIES=3

# Checkpoint configuration
ROMA_CHECKPOINT_ENABLED=true
ROMA_CHECKPOINT_PATH=.checkpoints
ROMA_MAX_CHECKPOINTS=10

# ========================================
# PostgreSQL (Optional - for persistence)
# ========================================

# Enable PostgreSQL storage
POSTGRES_ENABLED=false

# Connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/roma

# Connection pool settings
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10
# POSTGRES_POOL_TIMEOUT=30.0

# ========================================
# Observability (Optional)
# ========================================

# MLflow tracking
MLFLOW_ENABLED=false
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT=ROMA-Experiments

# Toolkit metrics
TOOLKIT_METRICS_ENABLED=true
TOOLKIT_TRACK_LIFECYCLE=true
TOOLKIT_TRACK_INVOCATIONS=true

# Event traces
EVENT_TRACES_ENABLED=true
EVENT_TRACK_EXECUTION=true
EVENT_TRACK_MODULES=true

# ========================================
# Logging Configuration
# ========================================

# Log directory (null = console only)
LOG_DIR=null

# Log format: default, minimal, detailed
LOG_CONSOLE_FORMAT=default

# Log rotation
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
